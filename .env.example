# ==============================================================================
# SepsisSense Environment Configuration Template
# All secrets must remain strictly server-side. Never commit real keys.
# ==============================================================================

# Core Flask Configuration
SECRET_KEY=generate-a-strong-random-key-here
FLASK_ENV=production
ADMIN_SECRET=set-a-strong-admin-bootstrap-secret

# Database Configuration (Optional: Defaults to SQLite sepsis.db if not provided)
DATABASE_URL=
SUPABASE_DB_URL=

# Google OAuth (Optional: Enables real Google login flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-Side Conversational LLM (Optional: Enables live multi-turn AI responses)
# Compatible with OpenAI, Gemini OpenAI endpoint, Groq, or self-hosted Ollama/vLLM
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1/chat/completions

# Email Notification Service (Gmail API or SMTP)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=notifications@sepsissense.org

# SMTP Fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Twilio WhatsApp Alert Service
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Device Ingestion Security (Optional)
DEVICE_AUTH_SECRET=
